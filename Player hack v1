-- ฟังก์ชันสุ่มรหัสแบบมั่วๆ เท่ๆ
local function generateRandomPassword()
    local patterns = {
        function() return "Pass#" .. math.random(10000, 99999) end,
        function() return "Secret_" .. math.random(1000, 9999) .. "!!end" end,
        function() 
            local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$"
            local p = ""
            for i = 1, 10 do p = p .. string.sub(chars, math.random(1, #chars), math.random(1, #chars)) end
            return p
        end
    }
    return patterns[math.random(1, #patterns)]()
end

-- กดปุ่มค้นหา (แฮกเกอร์สไตล์ รัวข้อความตอนโหลด)
local isProcessing = false
actionButton.MouseButton1Click:Connect(function()
    if isProcessing then return end
    local target = textBox.Text
    
    if target == "" then
        resultText.Text = "⚠️ กรุณาใส่ชื่อผู้เล่นก่อน!"
        avatarImage.Image = ""
        return
    end

    isProcessing = true
    lastTargetName = target
    avatarImage.Image = ""
    
    -- จำลองข้อความแฮกเกอร์รัวๆ
    resultText.Text = "[-] กำลังเชื่อมต่อเซิร์ฟเวอร์..."
    task.wait(0.2)
    resultText.Text = "[*] เจาะระบบไอพีเป้าหมาย: " .. target
    task.wait(0.25)
    resultText.Text = "[+] ถอดรหัสไฟร์วอลล์สำเร็จ..."
    task.wait(0.25)
    resultText.Text = "[!] ดึงข้อมูลลับกำลังดำเนินการ..."
    task.wait(0.25)
    
    -- สุ่มโอกาสสำเร็จ
    local isSuccess = math.random(1, 100) <= 85
    
    if isSuccess then
        lastPassword = generateRandomPassword()
        resultText.Text = string.format("เป้าหมาย: %s\nสถานะ: เจาะสำเร็จ ✨\n\nรหัสผ่าน:\n-> %s", target, lastPassword)
        
        -- ดึงรูปหน้าตัวละคร (Avatar Headshot)
        pcall(function()
            local userId = Players:GetUserIdFromNameAsync(target)
            if userId then
                local thumbType = Enum.ThumbnailType.HeadShot
                local thumbSize = Enum.ThumbnailSize.Size420x420
                local content, isReady = Players:GetUserThumbnailAsync(userId, thumbType, thumbSize)
                avatarImage.Image = content
            end
        end)
    else
        lastPassword = ""
        resultText.Text = string.format("เป้าหมาย: %s\nสถานะ: ล้มเหลว (ป้องกันหนาแน่น) ❌", target)
    end
    
    isProcessing = false
end)

